# Railroad Environment Variables Template
# Copy this to .env.local for local development
# Railway will use these from the Railway dashboard

# Server Configuration
PORT=5501
NODE_ENV=production

# Database Configuration (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=ctu_room_management
DB_PORT=3306

# System Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SYSTEM_NAME=CTU Room Management System
